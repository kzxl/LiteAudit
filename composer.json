{
    "name": "kzxl/lite-audit",
    "description": "High-performance enterprise audit trail and entity change tracking engine for PHP 8.2+ with automatic Git-like diffs and LiteORM integration",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/kzxl/LiteAudit",
    "support": {
        "issues": "https://github.com/kzxl/LiteAudit/issues",
        "source": "https://github.com/kzxl/LiteAudit"
    },
    "authors": [
        {
            "name": "Phong Vo",
            "email": "phong.vo@kzxl.com"
        }
    ],
    "keywords": [
        "audit",
        "audit-trail",
        "change-tracking",
        "ledger",
        "diff",
        "liteorm",
        "php82"
    ],
    "replace": {
        "kzxl/liteaudit": "self.version"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../LiteORM"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "kzxl/lite-orm": "*"
    },
    "autoload": {
        "psr-4": {
            "LiteAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LiteAudit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
