{
    "name": "kzxl/lite-audit",
    "description": "High-performance enterprise audit trail and entity change tracking engine for PHP 8.2+ with automatic Git-like diffs and LiteORM integration",
    "type": "library",
    "license": "Apache-2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../LiteORM"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "kzxl/liteorm": "*"
    },
    "autoload": {
        "psr-4": {
            "LiteAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LiteAudit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
